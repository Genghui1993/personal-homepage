{
  "name": "ai-evolution-space",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "bash scripts/with-node.sh next dev --turbo -H 127.0.0.1 -p 3000",
    "dev:clean": "rm -rf .next && bash scripts/with-node.sh next dev --turbo -H 127.0.0.1 -p 3000",
    "dev:webpack": "bash scripts/with-node.sh next dev -H 127.0.0.1 -p 3000",
    "build": "bash scripts/with-node.sh next build",
    "start": "bash scripts/with-node.sh next start",
    "lint": "bash scripts/with-node.sh next lint",
    "sync:articles": "bash scripts/with-node.sh node scripts/sync-articles.js"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "next": "^15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
